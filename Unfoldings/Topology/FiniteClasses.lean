module

public import Mathlib.Logic.Relation
public import Mathlib.Data.Set.Finite.Basic

/-!
# Finite relation classes with finitely many branching points

If a relation preserves a finite exceptional set and every other point has at
most one undirected neighbor, all equivalence classes generated by the relation
are finite. This lemma has no dependency on metric or unfolding geometry.
-/

@[expose] public section

namespace Unfoldings

variable {X : Type*} {r : X → X → Prop} {v : Set X}

theorem eqvGen_preserves (preserves : ∀ x y, r x y → (x ∈ v ↔ y ∈ v))
    {x y : X} (related : Relation.EqvGen r x y) : x ∈ v ↔ y ∈ v := by
  induction related with
  | rel a b h => exact preserves a b h
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ hab hbc => exact hab.trans hbc

/-- Outside the exceptional set, every generated class consists of a point and its neighbor. -/
theorem eq_or_adj_of_eqvGen_of_unique_neighbors
    (preserves : ∀ x y, r x y → (x ∈ v ↔ y ∈ v))
    (unique : ∀ x ∉ v, ∀ {y z}, (r x y ∨ r y x) → (r x z ∨ r z x) → y = z)
    {x y : X} (related : Relation.EqvGen r x y) (regular : x ∉ v) :
    x = y ∨ r x y ∨ r y x := by
  induction related with
  | rel a b h => exact Or.inr (Or.inl h)
  | refl => exact Or.inl rfl
  | symm a b h ih =>
    have regular' : a ∉ v := fun ha => regular ((eqvGen_preserves preserves h).mp ha)
    rcases ih regular' with equal | forward | backward
    · exact Or.inl equal.symm
    · exact Or.inr (Or.inr forward)
    · exact Or.inr (Or.inl backward)
  | trans a b c hab hbc ihab ihbc =>
    have regular' : b ∉ v := fun hb => regular ((eqvGen_preserves preserves hab).mpr hb)
    rcases ihab regular with rfl | adjacent
    · exact ihbc regular
    rcases ihbc regular' with rfl | adjacent'
    · exact Or.inr adjacent
    · exact Or.inl (unique b regular' (adjacent.elim Or.inr Or.inl) adjacent')

/-- A finite exceptional set and unique neighbors elsewhere give finite generated classes. -/
theorem finite_eqvGen_class_of_finite_exceptional (finite : v.Finite)
    (preserves : ∀ x y, r x y → (x ∈ v ↔ y ∈ v))
    (unique : ∀ x ∉ v, ∀ {y z}, (r x y ∨ r y x) → (r x z ∨ r z x) → y = z)
    (x : X) : {y | Relation.EqvGen r x y}.Finite := by
  by_cases exceptional : x ∈ v
  · exact finite.subset (fun y hy => (eqvGen_preserves preserves hy).mp exceptional)
  · have neighbors : {y | r x y ∨ r y x}.Subsingleton :=
      fun _ hy _ hz => unique x exceptional hy hz
    apply ((Set.finite_singleton x).union neighbors.finite).subset
    intro y hy
    rcases eq_or_adj_of_eqvGen_of_unique_neighbors preserves unique hy exceptional with equal | adj
    · exact Or.inl equal.symm
    · exact Or.inr adj

end Unfoldings
