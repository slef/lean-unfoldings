module

public import Unfoldings.Geometry.SegmentInequalities
public import Unfoldings.Geometry.AffineArrangementGerm
public import Unfoldings.Geometry.HomogeneousGerm

/-! Actual endpoint cut directions, including degenerate segments. -/

@[expose] public section

open Filter Topology
open scoped NNReal

namespace Unfoldings

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The geometric nonnegative ray generated by an actual incident edge vector. -/
def nonnegativeRay (direction : E) : Set E :=
  {v | ∃ t : ℝ, 0 ≤ t ∧ v = t • direction}

theorem mem_nonnegativeRay_smul_iff (direction v : E) {r : ℝ} (positive : 0 < r) :
    r • v ∈ nonnegativeRay direction ↔ v ∈ nonnegativeRay direction := by
  constructor
  · rintro ⟨t, nonnegative, equal⟩
    refine ⟨r⁻¹ * t, mul_nonneg (inv_nonneg.mpr positive.le) nonnegative, ?_⟩
    have divided := congrArg (fun z : E => r⁻¹ • z) equal
    simpa only [smul_smul, inv_mul_cancel₀ positive.ne', one_smul] using divided
  · rintro ⟨t, nonnegative, equal⟩
    exact ⟨r * t, mul_nonneg positive.le nonnegative, by rw [equal, smul_smul]⟩

/-- Near an actual endpoint, the exact segment has its nonnegative edge-direction model. -/
theorem eventually_mem_segment_iff_nonnegativeRay (a b : E) :
    ∀ᶠ z in 𝓝 a, z ∈ segment ℝ a b ↔ z - a ∈ nonnegativeRay (b - a) := by
  by_cases different : a ≠ b
  · have positive : 0 < ‖b - a‖ := norm_pos_iff.mpr (sub_ne_zero.mpr different.symm)
    filter_upwards [Metric.ball_mem_nhds a positive] with z near
    constructor
    · intro member
      rw [segment_eq_image_lineMap] at member
      obtain ⟨t, bounds, rfl⟩ := member
      exact ⟨t, bounds.1, by simp only [AffineMap.lineMap_apply_module', add_sub_cancel_right]⟩
    · rintro ⟨t, nonnegative, equal⟩
      have distance : dist z a = t * ‖b - a‖ := by
        rw [dist_eq_norm, equal, norm_smul, Real.norm_of_nonneg nonnegative]
      have before : t ≤ 1 := by
        have close := Metric.mem_ball.mp near
        rw [distance] at close
        nlinarith
      have point : z = AffineMap.lineMap a b t := by
        rw [AffineMap.lineMap_apply_module']
        exact sub_eq_iff_eq_add.mp equal
      rw [point]
      exact lineMap_mem_segment ℝ a b ⟨nonnegative, before⟩
  · have same : a = b := not_ne_iff.mp different
    subst b
    apply Filter.Eventually.of_forall
    intro z
    simp only [segment_same, Set.mem_singleton_iff, sub_self, nonnegativeRay,
      Set.mem_ofPred_eq, smul_zero, sub_eq_zero]
    constructor
    · intro equal
      exact ⟨0, le_rfl, equal⟩
    · rintro ⟨_t, _nonnegative, equal⟩
      exact equal

/-- The affine-cell cone at the initial endpoint is exactly the original outgoing ray. -/
theorem segment_cellGerm_start (a b : Plane) :
    AffineArrangement.cellGerm (segmentInequalities a b) (fun _ => true) a =
      nonnegativeRay (b - a) := by
  apply eq_of_local_homogeneous_models a
    (fun v r positive => AffineArrangement.mem_cellGerm_smul_iff _ _ _ v positive)
    (fun v r positive => mem_nonnegativeRay_smul_iff _ v positive)
  · simpa only [← segment_eq_closedChamber] using
      AffineArrangement.eventually_mem_closedChamber_iff_cellGerm
        (segmentInequalities a b) (fun _ => true) a
  · exact eventually_mem_segment_iff_nonnegativeRay a b

/-- At the terminal endpoint the original incoming edge contributes the reverse ray. -/
theorem segment_cellGerm_finish (a b : Plane) :
    AffineArrangement.cellGerm (segmentInequalities a b) (fun _ => true) b =
      nonnegativeRay (a - b) := by
  apply eq_of_local_homogeneous_models b
    (fun v r positive => AffineArrangement.mem_cellGerm_smul_iff _ _ _ v positive)
    (fun v r positive => mem_nonnegativeRay_smul_iff _ v positive)
  · simpa only [← segment_eq_closedChamber] using
      AffineArrangement.eventually_mem_closedChamber_iff_cellGerm
        (segmentInequalities a b) (fun _ => true) b
  · simpa only [segment_symm ℝ b a] using eventually_mem_segment_iff_nonnegativeRay b a

/-- The entire parameterized nonnegative line is exactly its translated direction ray. -/
theorem mem_range_nonnegative_lineMap_iff (a b z : E) :
    z ∈ Set.range (fun t : ℝ≥0 => AffineMap.lineMap a b (t : ℝ)) ↔
      z - a ∈ nonnegativeRay (b - a) := by
  constructor
  · rintro ⟨t, rfl⟩
    exact ⟨t, t.coe_nonneg, by
      simp only [AffineMap.lineMap_apply_module', add_sub_cancel_right]⟩
  · rintro ⟨t, nonnegative, equal⟩
    refine ⟨(⟨t, nonnegative⟩ : ℝ≥0), ?_⟩
    change AffineMap.lineMap a b t = z
    rw [AffineMap.lineMap_apply_module']
    exact (sub_eq_iff_eq_add.mp equal).symm

/-- The affine-cell model of an actual terminal ray has its original outgoing direction. -/
theorem ray_cellGerm_start (a b : Plane) :
    AffineArrangement.cellGerm (rayInequalities a b) (fun _ => true) a =
      nonnegativeRay (b - a) := by
  apply eq_of_local_homogeneous_models a
    (fun v r positive => AffineArrangement.mem_cellGerm_smul_iff _ _ _ v positive)
    (fun v r positive => mem_nonnegativeRay_smul_iff _ v positive)
  · simpa only [← ray_eq_closedChamber] using
      AffineArrangement.eventually_mem_closedChamber_iff_cellGerm
        (rayInequalities a b) (fun _ => true) a
  · exact Filter.Eventually.of_forall (mem_range_nonnegative_lineMap_iff a b)

end Unfoldings
