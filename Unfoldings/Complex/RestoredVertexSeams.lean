module

public import Unfoldings.Complex.LinkConnectivity

/-! Forgetting cuts joins only the actual original endpoint copies of restored seams. -/

@[expose] public section

noncomputable section

namespace Unfoldings.TriangleComplex

universe u v

variable {Face : Type u} [Fintype Face] (C : TriangleComplex.{u, v} Face)
  {small large : Set C.Seam}

/-- One restored seam joins its literal original endpoint copies in the finer cut. -/
def RestoredVertexSeam (small large : Set C.Seam) (x y : C.Vertex small) : Prop :=
  ∃ s ∈ large \ small, ∃ side b,
    let p := C.germOfEndpoint (C.seamSide s side) b
    let q := C.germOfEndpoint (C.seamSide s (!side)) (C.acrossEndpoint s side b)
    x = C.vertexOfCorner small p.1 ∧ y = C.vertexOfCorner small q.1

theorem RestoredVertexSeam.symm {x y : C.Vertex small}
    (joined : C.RestoredVertexSeam small large x y) : C.RestoredVertexSeam small large y x := by
  obtain ⟨s, kept, side, b, rfl, rfl⟩ := joined
  refine ⟨s, kept, !side, C.acrossEndpoint s side b, rfl, ?_⟩
  rw [Bool.not_not, C.acrossEndpoint_inverse]

/-- The vertex map that restores cuts has exactly the classes generated by the
original endpoint pairs of the restored seams. -/
theorem vertexForgetCuts_eq_iff_restoredVertexSeams (inc : small ⊆ large)
    (x y : C.Vertex small) :
    C.vertexForgetCuts inc x = C.vertexForgetCuts inc y ↔
      Relation.EqvGen (C.RestoredVertexSeam small large) x y := by
  classical
  constructor
  · intro equal
    obtain ⟨p, rfl⟩ := C.vertexOfCorner_surjective small x
    obtain ⟨q, rfl⟩ := C.vertexOfCorner_surjective small y
    let v (g : C.Germ) := C.vertexOfCorner small g.1
    let first : C.Germ := (p, false)
    let last : C.Germ := (q, false)
    have related := (C.germs_related_iff_vertex_eq large first last).mpr equal
    have transfer {p q : C.Germ} (related : Relation.EqvGen (C.GermStep large) p q) :
        Relation.EqvGen (C.RestoredVertexSeam small large) (v p) (v q) := by
      induction related with
      | rel p q step =>
        rcases step with rfl | rfl
        · exact Relation.EqvGen.refl _
        · by_cases paired : ∃ q, C.GermCrosses large p q
          · obtain ⟨q, joined⟩ := paired
            rw [C.mateGerm_of_crossing joined]
            obtain ⟨s, kept, side, b, rfl, rfl⟩ := joined
            by_cases already : s ∈ small
            · have crossed : C.GermCrosses small (C.germOfEndpoint (C.seamSide s side) b)
                  (C.germOfEndpoint (C.seamSide s (!side)) (C.acrossEndpoint s side b)) :=
                ⟨s, already, side, b, rfl, rfl⟩
              have same : v (C.germOfEndpoint (C.seamSide s side) b) =
                  v (C.germOfEndpoint (C.seamSide s (!side)) (C.acrossEndpoint s side b)) :=
                crossed.vertex_eq
              rw [same]
              exact Relation.EqvGen.refl _
            · exact Relation.EqvGen.rel _ _ ⟨s, ⟨kept, already⟩, side, b, rfl, rfl⟩
          · rw [show C.mateGerm large p = p by simp only [mateGerm, dite_eq_right paired]]
            exact Relation.EqvGen.refl _
      | refl => exact Relation.EqvGen.refl _
      | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
      | trans _ _ _ _ _ first last => exact Relation.EqvGen.trans _ _ _ first last
    exact transfer related
  · intro related
    induction related with
    | rel x y step =>
      obtain ⟨s, kept, side, b, rfl, rfl⟩ := step
      let p := C.germOfEndpoint (C.seamSide s side) b
      let q := C.germOfEndpoint (C.seamSide s (!side)) (C.acrossEndpoint s side b)
      have crossed : C.GermCrosses large p q := ⟨s, kept.1, side, b, rfl, rfl⟩
      exact crossed.vertex_eq
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ first last => exact first.trans last

end Unfoldings.TriangleComplex
