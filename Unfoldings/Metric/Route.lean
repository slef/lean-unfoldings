module

public import Mathlib.Topology.EMetricSpace.Basic
public import Mathlib.Basic.ENNReal.Operations

/-!
# Extended distance constructed from finite routes

A step cost need not satisfy the triangle inequality or be finite. Its route
distance is the largest extended pseudometric bounded by the step costs, when
the costs are symmetric. Empty routes supply zero self-distance. Infinite costs
allow disconnected components without selecting an artificial finite distance.
-/

@[expose] public section

open scoped ENNReal

namespace Unfoldings

universe u

/-- A finite sequence of steps, with its endpoints tracked by the type. -/
inductive Route (X : Type u) : X → X → Type u
  | nil (x : X) : Route X x x
  | cons (x y : X) {z : X} (tail : Route X y z) : Route X x z

namespace Route

variable {X : Type u} {x y z : X}

/-- Travel directly from one point to another. -/
def step (x y : X) : Route X x y := .cons x y (.nil y)

/-- Concatenate routes without identifying any of their intermediate points. -/
def append : {a b c : X} → Route X a b → Route X b c → Route X a c
  | _, _, _, .nil _, q => q
  | _, _, _, .cons a b tail, q => .cons a b (tail.append q)

/-- Traverse the steps in the opposite order and direction. -/
def reverse : {a b : X} → Route X a b → Route X b a
  | _, _, .nil _ => .nil _
  | _, _, .cons a b tail => tail.reverse.append (step b a)

/-- Sum of the nonnegative extended costs of the steps. -/
def length (cost : X → X → ℝ≥0∞) : {a b : X} → Route X a b → ℝ≥0∞
  | _, _, .nil _ => 0
  | _, _, .cons a b tail => cost a b + tail.length cost

@[simp] theorem length_nil (cost : X → X → ℝ≥0∞) (x : X) :
    (nil x).length cost = 0 := rfl

@[simp] theorem length_step (cost : X → X → ℝ≥0∞) (x y : X) :
    (step x y).length cost = cost x y := by simp [step, length]

@[simp] theorem length_append (cost : X → X → ℝ≥0∞)
    (p : Route X x y) (q : Route X y z) :
    (p.append q).length cost = p.length cost + q.length cost := by
  induction p with
  | nil => simp [append, length]
  | cons a b tail ih => simp [append, length, ih, add_assoc]

@[simp] theorem length_reverse (cost : X → X → ℝ≥0∞)
    (symmetric : ∀ a b, cost a b = cost b a) (p : Route X x y) :
    p.reverse.length cost = p.length cost := by
  induction p with
  | nil => rfl
  | cons a b tail ih => simp [reverse, length, ih, symmetric b a, add_comm]

theorem length_mono {cost cost' : X → X → ℝ≥0∞}
    (bound : ∀ a b, cost a b ≤ cost' a b) (p : Route X x y) :
    p.length cost ≤ p.length cost' := by
  induction p with
  | nil => exact le_rfl
  | cons a b tail ih => exact add_le_add (bound a b) ih

/-- The extended path distance generated by the step costs. -/
noncomputable def distance (cost : X → X → ℝ≥0∞) (x y : X) : ℝ≥0∞ :=
  ⨅ p : Route X x y, p.length cost

theorem distance_le_length (cost : X → X → ℝ≥0∞) (p : Route X x y) :
    distance cost x y ≤ p.length cost := iInf_le _ p

theorem distance_le_cost (cost : X → X → ℝ≥0∞) (x y : X) :
    distance cost x y ≤ cost x y := by
  simpa using distance_le_length cost (step x y)

@[simp] theorem distance_self (cost : X → X → ℝ≥0∞) (x : X) :
    distance cost x x = 0 :=
  le_antisymm (distance_le_length cost (.nil x)) bot_le

theorem distance_comm (cost : X → X → ℝ≥0∞)
    (symmetric : ∀ a b, cost a b = cost b a) (x y : X) :
    distance cost x y = distance cost y x := by
  have bound (a b : X) : distance cost a b ≤ distance cost b a := by
    apply le_iInf
    intro p
    simpa only [length_reverse cost symmetric] using distance_le_length cost p.reverse
  exact le_antisymm (bound x y) (bound y x)

theorem distance_triangle (cost : X → X → ℝ≥0∞) (x y z : X) :
    distance cost x z ≤ distance cost x y + distance cost y z := by
  apply ENNReal.le_iInf_add_iInf
  intro p q
  simpa only [length_append] using distance_le_length cost (p.append q)

/-- Every extended pseudometric bounded by the step costs is bounded by route distance. -/
theorem le_distance (cost d : X → X → ℝ≥0∞)
    (self : ∀ a, d a a = 0)
    (triangle : ∀ a b c, d a c ≤ d a b + d b c)
    (bound : ∀ a b, d a b ≤ cost a b) (x y : X) : d x y ≤ distance cost x y := by
  apply le_iInf
  intro p
  induction p with
  | nil a => simp [length, self]
  | cons a b tail ih => exact (triangle a b _).trans (add_le_add (bound a b) ih)

/-- Raising step costs, for example by removing zero-cost seams, cannot shorten routes. -/
theorem distance_mono {cost cost' : X → X → ℝ≥0∞}
    (bound : ∀ a b, cost a b ≤ cost' a b) (x y : X) :
    distance cost x y ≤ distance cost' x y := by
  exact le_iInf fun p => (distance_le_length cost p).trans (p.length_mono bound)

/-- Construct the pseudometric; it is not an assumption in subsequent gluing data. -/
@[instance_reducible] noncomputable def pseudoEMetricSpace (cost : X → X → ℝ≥0∞)
    (symmetric : ∀ a b, cost a b = cost b a) : PseudoEMetricSpace X :=
  PseudoEMetricSpace.ofEDist (distance cost) (distance_self cost)
    (distance_comm cost symmetric) (distance_triangle cost)

/-- A genuine extended pseudometric is unchanged by the route construction. -/
theorem distance_eq_edist [PseudoEMetricSpace X] (x y : X) :
    distance (edist : X → X → ℝ≥0∞) x y = edist x y :=
  le_antisymm (distance_le_cost _ x y)
    (le_distance _ _ edist_self edist_triangle (fun _ _ => le_rfl) x y)

end Route
end Unfoldings
