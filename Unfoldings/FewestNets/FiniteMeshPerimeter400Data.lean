def q400PentagonPerimeterBound : ℕ := 8136

def checkQ400FacePerimeterBlock (i : ℕ) : Bool :=
  (checkFaceBlockPerimeter certificateDenominator_pos 400 48 i).isLT
    (checkPerimeterBound ((q400FacePerimeterBounds[i]?).getD 0))

def checkQ400SeamPerimeterBlock (i : ℕ) : Bool :=
  (checkSeamBlockPerimeter certificateDenominator_pos 400 48 i).isLT
    (checkPerimeterBound ((q400SeamPerimeterBounds[i]?).getD 0))

def checkQ400PentagonPerimeter : Bool :=
  ((checkPentagon certificateDenominator_pos 400).arcUpperPerimeter certificateDenominator_pos).isLT
    (checkPerimeterBound q400PentagonPerimeterBound)

