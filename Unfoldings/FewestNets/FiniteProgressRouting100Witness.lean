def q100FirstSideWitness (side : Fin 6) : RoutingSideWitness 48 where
  lower := q100FirstPanels (side - 1)
  upper := q100FirstUpperPanels (side - 1)
  exterior := q100FirstExteriorPairs side

def checkQ100FirstSideWitness (side : Fin 6) : Bool :=
  checkRoutingSide certificateDenominator_pos
    (checkedQ100FirstCorner (side - 1)) (checkedQ100FirstCorner side)
    (checkedQ100FirstNormal side) checkQ100FirstBody (finRotate 48)
    (checkedQ100FirstOffset side) checkQ100FirstCot checkQ100FirstGamma
    (q100FirstSideWitness side)

