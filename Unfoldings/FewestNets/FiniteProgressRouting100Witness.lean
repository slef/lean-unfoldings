@[expose] public section

noncomputable section

namespace Unfoldings.FewestNets

open MeshStar

set_option linter.style.longLine false in
def q100FirstCachedCornerBounds (i : Fin 6) (j : Fin 2) :
    FixedPointInterval certificateDenominator :=
  (![
    ![⟨1145756504080208243099078, 1145756504082407266354630⟩, ⟨378984924412672171981374, 378984924414871195236926⟩],
    ![⟨-1099511627776, 1099511627776⟩, ⟨1202310656099119264194618, 1202310656101318287450170⟩],
    ![⟨-1145756504082407266354630, -1145756504080208243099078⟩, ⟨378984924412672171981374, 378984924414871195236926⟩],
    ![⟨-1145756504082407264070029, -1145756504080208240814477⟩, ⟨-392237739085363205962671, -392237739083164182707119⟩],
    ![⟨-1099511627776, 1099511627776⟩, ⟨-1215563470771810300771032, -1215563470769611277515480⟩],
    ![⟨1145756504080208240814477, 1145756504082407264070029⟩, ⟨-392237739085363205962671, -392237739083164182707119⟩]
  ] i : Fin 2 → FixedPointInterval certificateDenominator) j

set_option maxRecDepth 8192 in
theorem q100FirstCachedCornerBounds_valid (i : Fin 6) (j : Fin 2) :
    (checkQ100FirstCorner i j).insideBounds (q100FirstCachedCornerBounds i j) = true := by
  fin_cases i <;> fin_cases j <;> decide +kernel

def checkedQ100FirstCorner (i : Fin 6) :
    CheckedPlane certificateDenominator (q100FirstCorner i) :=
  fun j => (checkQ100FirstCorner i j).withWiderBounds (q100FirstCachedCornerBounds i j)
    (q100FirstCachedCornerBounds_valid i j)

