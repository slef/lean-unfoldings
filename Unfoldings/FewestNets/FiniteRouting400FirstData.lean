/-! The first saved frequency-400 cell, with exact maximum-radius coordinates. -/

@[expose] public section

noncomputable section
namespace Unfoldings.FewestNets
open MeshStar

def q400FirstModel := face 400 1 1

def q400FirstChecked := checkFace certificateDenominator_pos 400 1 1

def q400FirstCorner (k : Fin 6) := q400FirstModel.maximumNormalizedVertex k

def q400FirstNormal (k : Fin 6) := q400FirstModel.physicalSideNormal k

def q400FirstOffset (k : Fin 6) := q400FirstModel.maximumNormalizedSideOffset k

