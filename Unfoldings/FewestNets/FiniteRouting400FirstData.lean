def q400FirstRawCorner (k : Fin 6) : CheckedPlane certificateDenominator (q400FirstCorner k) :=
  q400FirstChecked.maximumNormalizedVertex certificateDenominator_pos k

def q400FirstRawNormal (k : Fin 6) : CheckedPlane certificateDenominator (q400FirstNormal k) :=
  q400FirstChecked.physicalSideNormal certificateDenominator_pos k

def q400FirstRawOffset (k : Fin 6) : CheckedReal certificateDenominator (q400FirstOffset k) :=
  q400FirstChecked.maximumNormalizedSideOffset certificateDenominator_pos k

set_option maxRecDepth 8192 in
theorem q400FirstCornerBox_ok (k : Fin 6) (j : Fin 2) :
    (q400FirstRawCorner k j).insideBounds (q400FirstCornerBox k j) = true := by
  fin_cases k <;> fin_cases j <;> decide +kernel

set_option maxRecDepth 8192 in
theorem q400FirstNormalBox_ok (k : Fin 6) (j : Fin 2) :
    (q400FirstRawNormal k j).insideBounds (q400FirstNormalBox k j) = true := by
  fin_cases k <;> fin_cases j <;> decide +kernel

set_option maxRecDepth 8192 in
theorem q400FirstOffsetBox_ok (k : Fin 6) :
    (q400FirstRawOffset k).insideBounds (q400FirstOffsetBox k) = true := by
  fin_cases k <;> decide +kernel

def q400FirstCachedCorner (k : Fin 6) : CheckedPlane certificateDenominator (q400FirstCorner k) :=
  fun j => (q400FirstRawCorner k j).withWiderBounds (q400FirstCornerBox k j) (q400FirstCornerBox_ok k j)

def q400FirstCachedNormal (k : Fin 6) : CheckedPlane certificateDenominator (q400FirstNormal k) :=
  fun j => (q400FirstRawNormal k j).withWiderBounds (q400FirstNormalBox k j) (q400FirstNormalBox_ok k j)

def q400FirstCachedOffset (k : Fin 6) : CheckedReal certificateDenominator (q400FirstOffset k) :=
  (q400FirstRawOffset k).withWiderBounds (q400FirstOffsetBox k) (q400FirstOffsetBox_ok k)

