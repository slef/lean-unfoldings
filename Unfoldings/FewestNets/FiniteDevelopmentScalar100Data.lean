module

public import Unfoldings.FewestNets.DevelopmentScalarRecord
public import Unfoldings.FewestNets.FiniteMeshKeys
public import Unfoldings.FewestNets.FiniteMeshExample

/-! The exact scalar fields of the paper's frequency-100 records. -/

@[expose] public section

namespace Unfoldings.FewestNets

inductive MeshRecordKey where
  | face (i j : ℕ)
  | seam (i : ℕ)
  | vertex
  deriving DecidableEq

def meshRecordKeys (q : ℕ) : List MeshRecordKey :=
  ((faceMeshKeys q).map fun (i, j) => .face i j) ++
    [.vertex] ++ (seamMeshKeys q).map MeshRecordKey.seam

abbrev KeyedDevelopmentScalar := MeshRecordKey × DevelopmentScalarRecord

