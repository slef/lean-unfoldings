module

public import Unfoldings.FewestNets.IcosahedronFineIntersections
public import Unfoldings.FewestNets.IcosahedronGridIndependence

/-! The overlap of two radial cones is generated by their shared normalized corners. -/

@[expose] public section

noncomputable section

namespace Unfoldings.FewestNets.Icosahedron

open NormedSpace
open scoped BigOperators

private theorem exists_chordTriangle_on_ray {q : ℕ} (t : MeshFace q) {x : Space}
    (hx : x ∈ radialTriangleCone (inscribedCorners t)) (nonzero : x ≠ 0) :
    ∃ a : ℝ, 0 < a ∧ a • x ∈ convexHull ℝ (Set.range (chordCorners t)) := by
  obtain ⟨u, nonnegative, equal⟩ := hx
  let v : Fin 3 → ℝ := fun k => u k * ‖chordCorners t k‖⁻¹
  have vp (k : Fin 3) : 0 ≤ v k := mul_nonneg (nonnegative k) (inv_nonneg.mpr (norm_nonneg _))
  have sum : x = ∑ k, v k • chordCorners t k := by
    rw [equal]
    simp only [inscribedCorners, NormedSpace.normalize, v, smul_smul]
  let total := ∑ k, v k
  have total_pos : 0 < total := by
    apply lt_of_le_of_ne (Finset.sum_nonneg (fun k _ => vp k))
    intro zero
    have zero_all (k : Fin 3) : v k = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg (fun k _ => vp k)).mp zero.symm k (Finset.mem_univ k)
    apply nonzero
    simp [sum, zero_all]
  refine ⟨total⁻¹, inv_pos.mpr total_pos, ?_⟩
  refine mem_convexHull_of_exists_fintype (fun k => total⁻¹ * v k) (chordCorners t)
    (fun k => mul_nonneg (inv_nonneg.mpr total_pos.le) (vp k)) ?_
    (fun k => Set.mem_range_self k) ?_
  · rw [← Finset.mul_sum, inv_mul_cancel₀ total_pos.ne']
  · simp_rw [mul_smul, ← Finset.smul_sum]
    rw [← sum]

private theorem eq_chordTriangle_on_ray {q : ℕ} (hq : 0 < q) (t s : MeshFace q)
    {x : Space} {a b : ℝ} (apos : 0 < a) (bpos : 0 < b)
    (ht : a • x ∈ convexHull ℝ (Set.range (chordCorners t)))
    (hs : b • x ∈ convexHull ℝ (Set.range (chordCorners s))) : a • x = b • x := by
  have hft := faceTriangle_subset_frontier t.1 (chordTriangle_subset_faceTriangle hq t ht)
  have hfs := faceTriangle_subset_frontier s.1 (chordTriangle_subset_faceTriangle hq s hs)
  apply frontier_eq_of_radial_rays_meet (show Convex ℝ hull from convex_convexHull ℝ _)
    zero_mem_interior_hull hft hfs bpos apos
  simp only [sub_zero, zero_add, smul_smul, mul_comm a b]

/-- Every nonzero point of two radial cones has a nonnegative expansion
using only normalized corners that are present in both. -/
theorem exists_shared_corner_expansion {q : ℕ} (hq : 0 < q) (t s : MeshFace q)
    {x : Space} (nonzero : x ≠ 0) (ht : x ∈ radialTriangleCone (inscribedCorners t))
    (hs : x ∈ radialTriangleCone (inscribedCorners s)) :
    ∃ w : Fin 3 → ℝ, (∀ k, 0 ≤ w k) ∧ (x = ∑ k, w k • inscribedCorners t k) ∧
      ∀ k, 0 < w k → inscribedCorners t k ∈ Set.range (inscribedCorners s) := by
  obtain ⟨a, apos, in_t⟩ := exists_chordTriangle_on_ray t ht nonzero
  obtain ⟨b, bpos, in_s⟩ := exists_chordTriangle_on_ray s hs nonzero
  have common := eq_chordTriangle_on_ray hq t s apos bpos in_t in_s
  obtain ⟨u, up, us, ux⟩ := TriangleGrid.exists_weights_of_mem_convexHull_range _ in_t
  let w : Fin 3 → ℝ := fun k => (a⁻¹ * u k) * ‖chordCorners t k‖
  have w_nonnegative (k : Fin 3) : 0 ≤ w k :=
    mul_nonneg (mul_nonneg (inv_nonneg.mpr apos.le) (up k)) (norm_nonneg _)
  refine ⟨w, w_nonnegative, ?_, ?_⟩
  · simp_rw [w, mul_smul, inscribedCorners, norm_smul_normalize, ← Finset.smul_sum, ux]
    rw [smul_smul, inv_mul_cancel₀ apos.ne', one_smul]
  · intro k h
    have uk : 0 < u k := by
      by_contra! absent
      have zero : u k = 0 := le_antisymm absent (up k)
      simp [w, zero] at h
    have member : (∑ k, u k • chordCorners t k) ∈ convexHull ℝ (Set.range (chordCorners s)) := by
      rwa [ux, common]
    obtain ⟨l, hl⟩ := chordCorners_mem_of_positive_combination hq t s u up us member k uk
    exact ⟨l, congrArg NormedSpace.normalize hl⟩

end Unfoldings.FewestNets.Icosahedron
